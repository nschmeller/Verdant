<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Verdant</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- HealthKit: we only READ health data; this string is shown in the permission sheet. -->
	<key>NSHealthShareUsageDescription</key>
	<string>Verdant reads your Apple Health history to find subtle, non-obvious connections across years of your data. All analysis runs on this iPhone using on-device AI — your health data never leaves the device and is never sent to any server.</string>

	<!-- Background execution: HKObserverQuery delivery + BackgroundTasks-scheduled analysis. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>

	<!-- BGTaskScheduler identifiers must be declared here to be permitted. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nschmeller.Verdant.refresh</string>
		<string>com.nschmeller.Verdant.enhance</string>
	</array>
</dict>
</plist>
